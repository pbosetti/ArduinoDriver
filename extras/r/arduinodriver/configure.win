#!/bin/sh
# configure.win - Windows counterpart of ./configure, run by R via Rtools'
# shell. Same approach as configure: build arduino_driver_c statically via
# CMake (using whatever generator Rtools' toolchain defaults to, normally
# MinGW Makefiles), from a local checkout override or a CMake FetchContent
# of the ArduinoDriver repo -- see configure's header comment for why a
# relative path to this repo's own siblings cannot be used here.
#
# The Windows system libraries below are a best-effort list for libusb's
# WinUSB backend (setupapi/winusb for device access, ole32/advapi32 for the
# COM and registry calls libusb's Windows backend makes); this path has not
# been verified on a Windows machine yet -- if linking fails with undefined
# references, check libusb-cmake's own Windows link requirements first.
set -e

PKG_ROOT=$(cd "$(dirname "$0")" && pwd)
BUILD_DIR="$PKG_ROOT/src/native-build"
GIT_TAG=${ARDUINODRIVER_GIT_TAG:-main}

CMAKE=$(command -v cmake || true)
if [ -z "$CMAKE" ]; then
  echo "configure.win: cmake not found on PATH; it is required to build arduino_driver_c." >&2
  exit 1
fi

if [ -n "$ARDUINODRIVER_LOCAL_CHECKOUT" ] && [ -f "$ARDUINODRIVER_LOCAL_CHECKOUT/extras/c_api/CMakeLists.txt" ]; then
  echo "configure.win: using local checkout at $ARDUINODRIVER_LOCAL_CHECKOUT"
  CMAKE_SOURCE_DIR="$ARDUINODRIVER_LOCAL_CHECKOUT/extras/c_api"
else
  echo "configure.win: fetching ArduinoDriver (git tag $GIT_TAG) via CMake FetchContent..."
  FETCH_DIR="$PKG_ROOT/src/native-fetch"
  mkdir -p "$FETCH_DIR"
  cat > "$FETCH_DIR/CMakeLists.txt" <<EOF
cmake_minimum_required(VERSION 3.24)
project(ArduinoDriverRFetch LANGUAGES NONE)
include(FetchContent)
FetchContent_Declare(arduinodriver_upstream
  GIT_REPOSITORY https://github.com/pbosetti/ArduinoDriver.git
  GIT_TAG $GIT_TAG
  GIT_SHALLOW TRUE)
FetchContent_MakeAvailable(arduinodriver_upstream)
add_subdirectory("\${arduinodriver_upstream_SOURCE_DIR}/extras/c_api" "\${CMAKE_CURRENT_BINARY_DIR}/c_api")
EOF
  CMAKE_SOURCE_DIR="$FETCH_DIR"
fi

"$CMAKE" -S "$CMAKE_SOURCE_DIR" -B "$BUILD_DIR" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
  -DARDUINODRIVER_C_API_SHARED=OFF \
  -DARDUINODRIVER_C_API_BUILD_TESTS=OFF \
  -DARDUINODRIVER_C_API_INSTALL=OFF \
  -DARDUINODRIVER_BUILD_CLI=OFF
"$CMAKE" --build "$BUILD_DIR" --target arduino_driver_c --config Release

find_one() {
  # See configure's comment: the header can live outside BUILD_DIR in
  # local-checkout mode, so CMAKE_SOURCE_DIR is searched too.
  find "$BUILD_DIR" "$CMAKE_SOURCE_DIR" -name "$1" -print -quit 2>/dev/null
}

ARDUINO_DRIVER_C_LIB=$(find_one 'libarduino_driver_c.a')
ARDUINO_DRIVER_LIB=$(find_one 'libarduino_driver.a')
FMT_LIB=$(find_one 'libfmt.a')
LIBUSB_LIB=$(find_one 'libusb-1.0.a')
HEADER=$(find_one 'arduino_driver_c.h')
EXPORT_HEADER=$(find_one 'adrv_export.h')

for name in ARDUINO_DRIVER_C_LIB ARDUINO_DRIVER_LIB FMT_LIB LIBUSB_LIB HEADER EXPORT_HEADER; do
  eval "value=\$$name"
  if [ -z "$value" ]; then
    echo "configure.win: could not find the built $name under $BUILD_DIR" >&2
    exit 1
  fi
done

HEADER_DIR=$(dirname "$HEADER")
EXPORT_HEADER_DIR=$(dirname "$EXPORT_HEADER")
EXTRA_LIBS="-lsetupapi -lwinusb -lole32 -ladvapi32"

cat > "$PKG_ROOT/src/Makevars.win" <<EOF
# Generated by configure.win; see configure.win for how these paths were found.
PKG_CPPFLAGS = -I$HEADER_DIR -I$EXPORT_HEADER_DIR
PKG_LIBS = $ARDUINO_DRIVER_C_LIB $ARDUINO_DRIVER_LIB $FMT_LIB $LIBUSB_LIB $EXTRA_LIBS
CXX_STD = CXX20
EOF

echo "configure.win: wrote $PKG_ROOT/src/Makevars.win"
exit 0
